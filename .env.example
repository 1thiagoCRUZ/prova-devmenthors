NODE_ENV=development
PORT=3000

# Neon: DATABASE_URL = string "pooled" (host com -pooler), usada pelo app.
#       DIRECT_URL   = string direta (sem -pooler), usada só pelo prisma migrate.
DATABASE_URL=postgresql://USER:SENHA@ep-xxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:SENHA@ep-xxx.REGIAO.aws.neon.tech/neondb?sslmode=require
# Postgres local (npm run db:embedded): só DATABASE_URL, sem DIRECT_URL.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/provas?schema=public

# Chave do professor (mínimo 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-chars
# Segredo do JWT de sessão do professor (mínimo 32 caracteres)
JWT_SECRET=troque-por-outro-segredo-aleatorio-de-32-chars-ou-mais
ADMIN_TOKEN_TTL_MINUTES=60

# Origem(ns) do front, separadas por vírgula
CORS_ORIGIN=http://localhost:5173
# true em produção (HTTPS). Em dev local via HTTP use false.
COOKIE_SECURE=false
# lax | strict | none (use none + COOKIE_SECURE=true se front e API estiverem em domínios diferentes)
COOKIE_SAMESITE=lax
